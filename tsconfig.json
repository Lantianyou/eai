{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["docs/.vuepress/**/*.ts"],
  "exclude": [
    "node_modules",
    "docs/.vuepress/dist",
    "docs/.vuepress/.temp",
    "docs/.vuepress/.cache"
  ]
}
